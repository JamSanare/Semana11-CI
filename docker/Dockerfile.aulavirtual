# AulaNova (aula virtual): servidor Node en el puerto 3000, sin dependencias externas.
FROM node:22-bookworm-slim
WORKDIR /app
COPY aulavirtual/package.json ./
COPY aulavirtual/backend/ backend/
COPY aulavirtual/app/ app/
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "backend/server.js"]
