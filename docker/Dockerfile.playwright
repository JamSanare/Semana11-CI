# Ejecutor de pruebas Playwright (pytest): 41 casos CP-01..CP-41.
# Imagen oficial: ya incluye Python, Playwright 1.49.1 y los navegadores.
FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install "playwright==1.49.1" "pytest-playwright==0.6.2"

COPY utils/ utils/
COPY tests/__init__.py tests/__init__.py
COPY tests/playwright/ tests/playwright/
COPY scripts/run_playwright.sh scripts/run_playwright.sh

CMD ["bash", "scripts/run_playwright.sh"]
