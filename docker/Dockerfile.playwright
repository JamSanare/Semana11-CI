# Ejecutor de pruebas Playwright (pytest): 41 casos CP-01..CP-41.
FROM python:3.12-slim

ARG PLAYWRIGHT_VERSION=1.49.1
ARG PYTEST_PLAYWRIGHT_VERSION=0.6.2

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN pip install "playwright==${PLAYWRIGHT_VERSION}" "pytest-playwright==${PYTEST_PLAYWRIGHT_VERSION}" \
    && playwright install --with-deps chromium

COPY utils/ utils/
COPY tests/__init__.py tests/__init__.py
COPY tests/playwright/ tests/playwright/
COPY scripts/run_playwright.sh scripts/run_playwright.sh

CMD ["bash", "scripts/run_playwright.sh"]
