# Ejecutor de pruebas de AulaNova: unitarias + funcionales (node --test) y k6
# (rendimiento, estrés, seguridad). Incluye Node y el binario de k6.
FROM grafana/k6:1.0.0 AS k6

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
COPY --from=k6 /usr/bin/k6 /usr/local/bin/k6
WORKDIR /app
COPY aulavirtual/ ./
CMD ["bash", "pruebas/scripts/ejecutar.sh", "funcional"]
